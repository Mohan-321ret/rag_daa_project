{
  "info": {
    "name": "FinalYear Project API",
    "description": "Phase 1 – API collection. Module 1: Document Ingestion added.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Module 1 – Document Ingestion",
      "item": [
        {
          "name": "Upload Document (PDF)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/documents/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/your/document.pdf",
                  "description": "Select a PDF, DOCX, TXT, HTML, or PPTX file"
                },
                {
                  "key": "department",
                  "value": "HR",
                  "type": "text",
                  "description": "Optional department label"
                },
                {
                  "key": "permissions",
                  "value": "private",
                  "type": "text",
                  "description": "private | internal | public"
                },
                {
                  "key": "language",
                  "value": "en",
                  "type": "text",
                  "description": "Optional language hint"
                }
              ]
            }
          }
        },
        {
          "name": "Get Document by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/documents/DOC_XXXXXXXX",
            "description": "Replace DOC_XXXXXXXX with the document_id returned from upload."
          }
        },
        {
          "name": "List All Documents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/documents/?skip=0&limit=20",
              "query": [
                { "key": "skip", "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "LLM",
      "item": [
        {
          "name": "Generate Response",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/llm/generate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Explain vector databases in simple terms.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Embeddings",
      "item": [
        {
          "name": "Embed Text",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/embeddings/embed",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello, world!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Vector Store",
      "item": [
        {
          "name": "Add Document",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/vectors/add",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"FastAPI is a modern, fast web framework.\",\n  \"metadata\": { \"source\": \"docs\" }\n}"
            }
          }
        },
        {
          "name": "Search Documents",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/vectors/search",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"fast Python API framework\",\n  \"top_k\": 3\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Graph (Neo4j)",
      "item": [
        {
          "name": "Create Node",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/graph/node",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Concept\",\n  \"properties\": { \"name\": \"Vector Database\" }\n}"
            }
          }
        },
        {
          "name": "Get Nodes",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/graph/nodes/Concept"
          }
        }
      ]
    }
  ]
}
