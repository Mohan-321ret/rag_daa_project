# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="FinalYear Project API"
APP_ENV=development
DEBUG=true
SECRET_KEY=change_me_to_a_random_secret_key
# ↑ Also used to sign JWTs issued by the Authentication module (app/api/auth.py).

# ─── Authentication (JWT) ───────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Authentication (Google OAuth) ─────────────────────────────────────────────
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# (APIs & Services → Credentials → Create OAuth client ID → Web application).
# Add http://localhost:3000 to "Authorized JavaScript origins".
# The same value goes in frontend/.env.local as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
# Leave empty to disable Google Sign-In.
GOOGLE_CLIENT_ID=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# ⚠️  Copy this file to .env and uncomment the correct DATABASE_URL for your setup.

POSTGRES_DB=finalyear_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ── If running PostgreSQL via Docker Compose (docker-compose up postgres) ──────
# POSTGRES_HOST=postgres               # Docker internal hostname
# DATABASE_URL=postgresql+pg8000://postgres:postgres@postgres:5432/finalyear_db

# ── If running PostgreSQL natively on Windows / already installed ──────────────
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/finalyear_db

# ─── Neo4j ────────────────────────────────────────────────────────────────────
# ── If running via Docker Compose ─────────────────────────────────────────────
# NEO4J_URI=bolt://neo4j:7687

# ── If running natively ───────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | openai | groq
LLM_PROVIDER=ollama

# Ollama (local) ── If running via Docker Compose use http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3   # fallback used only if no alias/override is given (see below)

# ─── Enterprise LLM model registry (Phase 10 – Module 8) ──────────────────────
# Alias -> Ollama tag, so /rag/query's `model` field (or LLM_DEFAULT_MODEL_ALIAS)
# can request "llama3"/"gemma"/"mistral"/"qwen" without knowing the exact tag.
# `ollama pull <tag>` each one you want to use; check availability via
# GET /api/v1/llm/models. A raw tag not listed here (e.g. "gemma3:4b") also
# works directly — it's passed through unchanged.
LLM_MODEL_REGISTRY=llama3=llama3,gemma=gemma2,mistral=mistral,qwen=qwen2.5
LLM_DEFAULT_MODEL_ALIAS=llama3
LLM_TEMPERATURE=0.7

# OpenAI (cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (cloud)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192 

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ─── FAISS ────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=./data/faiss_index

# ─── Document Ingestion ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25
TEMP_UPLOAD_DIR=./data/tmp_uploads
DOC_ID_PREFIX=DOC
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.html,.pptx

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ─── Chunking (Phase 3 – Module 2) ────────────────────────────────────────────
# RecursiveCharacterTextSplitter settings
CHUNK_SIZE=1000          # target characters per chunk
CHUNK_OVERLAP=200        # overlap between consecutive chunks (for context continuity)
CHUNK_MIN_LENGTH=50      # discard chunks shorter than this (noise filter)

# ─── Embedding Model ───────────────────────────────────────────────────────────
# Option A: fast, small (default) – dim=384
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384

# Option B: high quality – dim=1024 (change FAISS index if switching)
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# EMBEDDING_DIMENSION=1024

# ─── Knowledge Evolution Engine (Phase 6 – Module 3) ──────────────────────────
# Step 1 – Document Change Monitor: background folder watcher
WATCH_ENABLED=true
WATCH_DIR=./data/watched_docs
WATCH_POLL_INTERVAL_S=10

# Step 3 – Concept Drift Detection (cosine similarity thresholds, 0..1)
DRIFT_THRESHOLD=0.80          # doc-level: below this ⇒ concept changed
CHUNK_DRIFT_THRESHOLD=0.75    # chunk-level: below this ⇒ chunk drifted

# Step 4 – Conflict Detection
CONFLICT_FUZZY_THRESHOLD=0.75 # min masked-statement similarity to pair sentences
MAX_CONFLICTS_REPORTED=20

# Step 2 – Version Comparator
MAX_DIFF_CHARS=20000          # cap stored unified diff size

# ─── Query Intelligence Module (Phase 7 – Module 5) ───────────────────────────
# NER: run `python -m spacy download en_core_web_sm` after installing requirements
SPACY_MODEL=en_core_web_sm

# Intent Detection: heuristic (fast, rule-based, default) | llm (few-shot prompt)
INTENT_DETECTION_METHOD=heuristic
INTENT_LLM_CONFIDENCE=0.75

# Complexity Analyzer thresholds (raw weighted score)
COMPLEXITY_MEDIUM_THRESHOLD=3.0
COMPLEXITY_COMPLEX_THRESHOLD=6.0

# RAG integration: widen FAISS retrieval breadth for medium/complex queries
COMPLEXITY_TOP_K_MEDIUM=8
COMPLEXITY_TOP_K_COMPLEX=12

# ─── Adaptive Retrieval Engine (Phase 8 – Module 6) ────────────────────────────
# Router: regex for "exact policy number" queries -> BM25 route (see config.py
# for the full default pattern; override here only if you need a different one)
# POLICY_NUMBER_PATTERN=...

# Router: keyword phrases (comma-separated) that trigger the Knowledge Graph route
RELATIONSHIP_KEYWORDS=relationship between,related to,relation to,connected to,connection between,reports to,reporting to,part of,belongs to,managed by,linked to,associated with,works with,works under,depends on,affects,impacts,responsible for,owned by,parent of,subsidiary of,who owns,who manages

BM25_TOP_K=5
GRAPH_TOP_K=5
HYBRID_RRF_K=60          # Reciprocal Rank Fusion smoothing constant

# ─── Context Fusion (Phase 9 – Module 7) ───────────────────────────────────────
# Step 1 – Duplicate Removal (Jaccard shingle similarity, 0..1)
DEDUP_SIMILARITY_THRESHOLD=0.85
DEDUP_SHINGLE_SIZE=5

# Step 2 – Cross Encoder Ranking (downloads on first use if not cached)
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Step 3 – Context Compression
CONTEXT_MAX_CHARS=6000          # total optimized-context budget sent to the LLM
CONTEXT_CHUNK_MAX_CHARS=800     # per-chunk cap after sentence trimming
CONTEXT_MIN_SENTENCES_PER_CHUNK=1

# ─── Evidence Verification (Phase 11 – Module 9) ───────────────────────────────
VERIFICATION_ENABLED=true
VERIFICATION_EVIDENCE_TOP_K=3            # evidence chunks re-retrieved per claim
# Semantic (embedding) similarity above which an evidence sentence counts as
# "about the same fact" as a claim (LLM paraphrasing needs semantic, not
# lexical, matching -- see fact_verifier.py docstring for the calibration)
VERIFICATION_STATEMENT_SIMILARITY_THRESHOLD=0.45
VERIFICATION_MIN_CLAIM_CHARS=8

# ─── Continuous Learning (Phase 12 – Module 10) ────────────────────────────────
QUERY_LOGGING_ENABLED=true          # Store step: log every /rag/query call
CONTINUOUS_LEARNING_ENABLED=true    # gate Improve Routing / Improve Retrieval

# A route/intent needs at least this many 👍/👎 ratings before its
# satisfaction score is trusted enough to influence future routing.
LEARNING_MIN_SAMPLES=5
# Below this satisfaction ratio (0..1), a route is considered underperforming.
LEARNING_SATISFACTION_THRESHOLD=0.5
# How much to widen top_k for an underperforming route (capped multiplier).
LEARNING_TOPK_BOOST=1.5
LEARNING_TOPK_BOOST_MAX=20

# Default aggregation window (days) for GET /feedback/metrics/summary.
METRICS_DEFAULT_WINDOW_DAYS=30

# ─── Automatic Ticketing ───────────────────────────────────────────────────────
# When a /rag/query answer's verification confidence falls below the threshold,
# a review ticket is raised automatically, tagged with the department of the
# answer's source documents. Requires VERIFICATION_ENABLED=true.
TICKETING_ENABLED=true
TICKET_CONFIDENCE_THRESHOLD=0.5
TICKET_DEFAULT_DEPARTMENT=General

