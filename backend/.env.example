# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="FinalYear Project API"
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=change_me_to_a_random_secret_key

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finalyear_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/finalyear_db

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | openai | groq
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# OpenAI (cloud)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Groq (cloud)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-8b-8192

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ─── FAISS ────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=./data/faiss_index

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
