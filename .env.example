# ==============================================================================
# DAA-RAG Project - Environment Configuration Template
# Copy this file to `.env` in the project root before running docker compose up
# ==============================================================================

# ── App & Security ─────────────────────────────────────────────────────────────
APP_NAME="FinalYear Project API"
APP_ENV=development
DEBUG=true
SECRET_KEY=change_me_to_a_random_secret_key_for_security

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finalyear_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+pg8000://postgres:postgres@postgres:5432/finalyear_db

# ── LLM Provider (Groq API) ──────────────────────────────────────────────────
# Options: groq | ollama | openai
LLM_PROVIDER=groq
GROQ_API_KEY=ur api keyy
GROQ_MODEL=qwen/qwen3.6-27b

# ── Embeddings & FAISS ────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
FAISS_INDEX_PATH=./data/faiss_index

# ── Frontend API Endpoint ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Google OAuth (Optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
